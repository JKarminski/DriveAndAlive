<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.example.driveandalive.ui.game.GameView
        android:id="@+id/game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reverse"
            android:layout_width="170dp"
            android:layout_height="90dp"
            android:text="◀"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/bg_card_elevated"
            app:cornerRadius="28dp"
            android:elevation="8dp" />

        <LinearLayout
            android:id="@+id/gear_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="110dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gear_down"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="▼"
                android:textSize="20sp"
                app:backgroundTint="@color/bg_card"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gear_up"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="▲"
                android:textSize="20sp"
                app:backgroundTint="@color/bg_card" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gas"
            android:layout_width="170dp"
            android:layout_height="90dp"
            android:text="▶"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/accent_orange"
            app:cornerRadius="28dp"
            android:elevation="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nitro"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="🚀"
            android:textSize="28sp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="110dp"
            app:backgroundTint="@color/accent_orange"
            app:cornerRadius="40dp"
            android:elevation="6dp"
            android:alpha="0.5" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
